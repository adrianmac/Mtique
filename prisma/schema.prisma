// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model InventoryItem {
  id             Int     @id @default(autoincrement())
  name           String
  category       String
  sku            String  @unique
  stockAvailable Int
  stockTotal     Int
  price          Float
  imageUrl       String?
}
